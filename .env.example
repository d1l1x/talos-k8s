# Proxmox API (bpg/proxmox provider)
# Copy to .env and fill in. Source with: set -a && source .env && set +a
#
# Token format: user@realm!tokenid=uuid-secret
# Example: tofu@pam!tofu-deployment=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

PROXMOX_VE_ENDPOINT=https://10.0.0.5:8006/
PROXMOX_VE_API_TOKEN=
PROXMOX_VE_INSECURE=true
